# =========================
# SahkarSetu Backend Environment Variables
# Multilingual Cooperative Governance & Legal Assistance Chatbot
# Ministry of Cooperation / NCCT | SIH 2026 (PS ID: 26088)
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# =========================

# --- Environment ---
# "development" (default) enables Ollama fallback, verbose logs
# "production" enforces Groq-only, strict CORS, optimized settings
ENV=development

# --- Database ---
# Local dev (leave unset or blank): uses SQLite at data/governance.db
# Production: postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=

# --- LLM (Groq Cloud - required in production) ---
# Get key at https://console.groq.com/keys (FREE tier available)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Voice (Sarvam AI - required for SahkarVaani) ---
# Get key at https://dashboard.sarvam.ai (FREE ₹1000 credits)
# Supports 22 Indian languages for STT, 11+ for TTS
SARVAM_API_KEY=

# --- Authentication ---
# REQUIRED in production. Generate via:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# --- First-admin bootstrap (used once by scripts/create_first_admin.py) ---
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Reverse proxy trust ---
TRUSTED_PROXIES=*

# --- Captcha (Cloudflare Turnstile) ---
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Server ---
PORT=8001
HOST=0.0.0.0

# --- RAG ---
FAISS_INDEX_PATH=data/faiss_index.bin
MODEL_CACHE_DIR=models
EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2

# --- Ollama (DEV ONLY - ignored in production) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=INFO
